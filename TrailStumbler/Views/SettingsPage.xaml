<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TrailStumbler.ViewModels"
             x:DataType="vm:SettingsViewModel"
             x:Class="TrailStumbler.Views.SettingsPage"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Basemap style" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding StyleNames}"
                    SelectedItem="{Binding SelectedStyleName, Mode=TwoWay}" />

            <Entry Placeholder="https://…/style.json"
                   Text="{Binding CustomStyleUrl, Mode=TwoWay}"
                   IsVisible="{Binding IsCustom}" />

            <Label Text="The map picks up style changes the next time it appears."
                   FontSize="12" TextColor="Gray" />

            <!-- Which imported points the map shows -->
            <Label Text="Points on the map" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="Kinds of imported points to show. Waypoints of your own (GPX, GeoJSON) always show."
                   FontSize="12" TextColor="Gray" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PointCategories}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PointCategoryOption">
                        <HorizontalStackLayout Spacing="4">
                            <CheckBox IsChecked="{Binding IsShown, Mode=TwoWay}" VerticalOptions="Center" />
                            <Label Text="{Binding Label}" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoryLabelTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
