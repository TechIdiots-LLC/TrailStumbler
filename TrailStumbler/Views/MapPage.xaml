<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TrailStumbler.ViewModels"
             xmlns:maplibre="clr-namespace:MapLibreNative.Maui.Handlers;assembly=MapLibreNative.Maui.Handlers"
             xmlns:routing="clr-namespace:MaplibreNative.Routing.Controls;assembly=MaplibreNative.Routing"
             x:DataType="vm:MapViewModel"
             x:Class="TrailStumbler.Views.MapPage"
             Title="Map">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding LabelsButtonText}"
                     Command="{Binding ToggleLabelsCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">

        <!-- Map fills Row 0. All trail/recording layers are added imperatively via
             the controller once the style has loaded (OnMapControllerReady). -->
        <maplibre:MapLibreMap
            Grid.Row="0"
            x:Name="Map"
            StyleUrl="{Binding StyleUrl}"
            ShowNavigationControls="True"
            ShowGpsControl="True"
            ShowAttributionControl="True"
            MyLocationEnabled="True" />

        <!-- Tap-to-inspect popup, floats over the bottom of the map, clear of the route sheet's header. -->
        <Border Grid.Row="0"
                x:Name="InfoPopup"
                VerticalOptions="End"
                Margin="10,0,10,74"
                Padding="14,12"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2E2E2E}"
                StrokeShape="RoundRectangle 10"
                Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}"
                IsVisible="{Binding IsPopupVisible}">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.25" Radius="12" Offset="0,2" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="3">
                <Label Grid.Row="0" Grid.Column="0"
                       Text="{Binding SelectedFeature.Title}"
                       TextColor="{AppThemeBinding Light=Black, Dark=#EEEEEE}"
                       FontAttributes="Bold" FontSize="16" />
                <Button Grid.Row="0" Grid.Column="1"
                        Text="✕"
                        Command="{Binding ClosePopupCommand}"
                        BackgroundColor="Transparent" TextColor="Gray"
                        Padding="6,0" FontSize="14" />

                <Label Grid.Row="1" Grid.ColumnSpan="2" FontSize="12" TextColor="Gray">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding SelectedFeature.LayerName}" />
                            <Span Text="  " />
                            <Span Text="{Binding SelectedFeature.Category}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <ScrollView Grid.Row="2" Grid.ColumnSpan="2" MaximumHeightRequest="120">
                    <Label Text="{Binding SelectedFeature.Description}"
                           FontSize="13" TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}"
                           IsVisible="{Binding SelectedFeature.Description, Converter={StaticResource IsNotNullOrEmpty}}" />
                </ScrollView>
            </Grid>
        </Border>

        <!-- Navigation panel — floats at top while navigating. -->
        <routing:NavigationPanel
            x:Name="NavPanel"
            Grid.Row="0"
            VerticalOptions="Start"
            IsVisible="{Binding IsNavigating}" />

        <!-- "Placing pin" tap-here banner — appears below NavPanel. -->
        <Border Grid.Row="0"
                VerticalOptions="Start"
                HorizontalOptions="Center"
                Margin="0,56,0,0"
                Padding="16,8"
                BackgroundColor="#CC1565C0"
                StrokeShape="RoundRectangle 20"
                Stroke="Transparent"
                IsVisible="{Binding IsPlacingPin}">
            <Label TextColor="White" FontSize="13" FontAttributes="Bold"
                   Text="{Binding PlacingPrompt}" />
        </Border>

        <!-- Recenter: the user moved the map while navigating; follow again -->
        <Button x:Name="RecenterButton"
                Grid.Row="0"
                Text="Recenter"
                Command="{Binding RecenterCommand}"
                VerticalOptions="End" HorizontalOptions="Start"
                Margin="10,0,0,84"
                BackgroundColor="#1565C0" TextColor="White"
                FontSize="13" Padding="14,0" CornerRadius="20"
                IsVisible="False">
            <Button.Triggers>
                <MultiTrigger TargetType="Button">
                    <MultiTrigger.Conditions>
                        <BindingCondition Binding="{Binding IsNavigating}" Value="True" />
                        <BindingCondition Binding="{Binding IsCameraPaused}" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="IsVisible" Value="True" />
                </MultiTrigger>
            </Button.Triggers>
        </Button>

        <!-- Pull-up route planner sheet. It sizes to its content; code-behind slides it up and down, and caps the
             content's height (scrolling beyond) so the map stays usable. Its header shows while it's tucked away. -->
        <Border x:Name="RouteSheet"
                Grid.Row="0"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#262626}"
                StrokeShape="RoundRectangle 16,16,0,0"
                Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#3A3A3A}">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.18" Radius="10" Offset="0,-2" />
            </Border.Shadow>

            <VerticalStackLayout>

                <!-- Header: grab bar, title and what's set. Tap or swipe to open and close. -->
                <Grid x:Name="SheetHeader"
                      RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,Auto"
                      Padding="16,6,16,8"
                      BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSheetHeaderTapped" />
                        <SwipeGestureRecognizer Direction="Up" Swiped="OnSheetSwipedUp" />
                        <SwipeGestureRecognizer Direction="Down" Swiped="OnSheetSwipedDown" />
                    </Grid.GestureRecognizers>
                    <BoxView Grid.ColumnSpan="2"
                             WidthRequest="40" HeightRequest="5" CornerRadius="3"
                             Color="{AppThemeBinding Light=#BBBBBB, Dark=#666666}"
                             HorizontalOptions="Center"
                             Margin="0,0,0,6" />
                    <VerticalStackLayout Grid.Row="1" Spacing="0">
                        <Label Text="Route"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#222222, Dark=#EEEEEE}" />
                        <Label Text="{Binding RouteSummary}"
                               FontSize="12"
                               LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    </VerticalStackLayout>
                    <Button x:Name="SheetChevron"
                            Grid.Row="1" Grid.Column="1"
                            Text="▲"
                            FontSize="13"
                            Padding="0"
                            WidthRequest="44"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#888888, Dark=#999999}"
                            SemanticProperties.Description="Route planner"
                            Clicked="OnSheetHeaderTapped" />
                </Grid>

                <!-- The planner itself, shown while the sheet is open. -->
                <ScrollView x:Name="SheetScroll" IsVisible="False">
                    <VerticalStackLayout x:Name="SheetContent"
                                         Spacing="8"
                                         Padding="14,0,14,14">

                        <!-- A (origin): highlighted while it's being placed -->
                        <Border Padding="12,4,6,4"
                                StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsPlacingOrigin}" Value="True">
                                    <Setter Property="Stroke" Value="#1565C0" />
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E3F2FD, Dark=#1B3350}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
                                <Ellipse WidthRequest="14" HeightRequest="14" Fill="#22AA22" VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding OriginLabel}"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="2"
                                        Text="Set A"
                                        Command="{Binding ActivateOriginPlacementCommand}"
                                        Clicked="OnPlacePinClicked"
                                        BackgroundColor="#22AA22" TextColor="White"
                                        FontSize="13" Padding="14,0" />
                            </Grid>
                        </Border>

                        <!-- B (destination) -->
                        <Border Padding="12,4,6,4"
                                StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsPlacingDestination}" Value="True">
                                    <Setter Property="Stroke" Value="#1565C0" />
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E3F2FD, Dark=#1B3350}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
                                <Ellipse WidthRequest="14" HeightRequest="14" Fill="#CC2222" VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding DestinationLabel}"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="2"
                                        Text="Set B"
                                        Command="{Binding ActivateDestinationPlacementCommand}"
                                        Clicked="OnPlacePinClicked"
                                        BackgroundColor="#CC2222" TextColor="White"
                                        FontSize="13" Padding="14,0" />
                            </Grid>
                        </Border>

                        <!-- How to get there -->
                        <Picker Title="Travel by"
                                ItemsSource="{x:Static vm:MapViewModel.ProfileNames}"
                                SelectedIndex="{Binding SelectedProfileIndex}"
                                FontSize="13"
                                TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" />

                        <!-- Routes to offer, before planning -->
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="8"
                              IsVisible="{Binding IsNavigating, Converter={StaticResource InvertBool}}">
                            <Label Text="{Binding RouteCountLabel}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="−" Command="{Binding DecreaseRouteCountCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                                    FontSize="16" Padding="0" WidthRequest="44" />
                            <Button Grid.Column="2" Text="+" Command="{Binding IncreaseRouteCountCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                                    FontSize="16" Padding="0" WidthRequest="44" />
                        </Grid>

                        <!-- Plan, start, stop, clear -->
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                            <Button Text="Plan Route"
                                    Command="{Binding PlanRouteCommand}"
                                    BackgroundColor="#1565C0" TextColor="White"
                                    FontSize="14" />
                            <Button Grid.Column="1"
                                    Text="Start"
                                    Command="{Binding StartRouteCommand}"
                                    BackgroundColor="#2E7D32" TextColor="White"
                                    FontSize="14" Padding="14,0"
                                    IsVisible="{Binding CanStart}" />
                            <Button Grid.Column="2"
                                    Text="Stop"
                                    Command="{Binding StopNavigationCommand}"
                                    BackgroundColor="#B71C1C" TextColor="White"
                                    FontSize="14" Padding="14,0"
                                    IsVisible="{Binding IsNavigating}" />
                            <Button Grid.Column="3"
                                    Text="Clear"
                                    Command="{Binding ClearWaypointsCommand}"
                                    BackgroundColor="#555555" TextColor="White"
                                    FontSize="14" Padding="14,0" />
                        </Grid>

                        <!-- With a route: voice, the whole route (navigating), a simulated drive -->
                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="8"
                              IsVisible="{Binding HasRouteOptions}">
                            <Button Text="{Binding VoiceButtonText}" Command="{Binding ToggleVoiceCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                                    FontSize="13" Padding="10,0" />
                            <Button Grid.Column="1" Text="Overview" Command="{Binding ShowOverviewCommand}"
                                    IsVisible="{Binding IsNavigating}"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                                    FontSize="13" Padding="10,0" />
                            <Button Grid.Column="2" Text="{Binding SimulateButtonText}" Command="{Binding ToggleSimulationCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                                    FontSize="13" Padding="10,0" />
                        </Grid>

                        <!-- Closures: places routes go round (a closed trail, a washed-out road) -->
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                            <Button Text="Closed ahead" Command="{Binding ClosedAheadCommand}"
                                    IsVisible="{Binding IsNavigating}"
                                    BackgroundColor="#B71C1C" TextColor="White"
                                    FontSize="13" Padding="10,0" />
                            <Button Grid.Column="1" Text="Mark closed"
                                    Command="{Binding ActivateClosurePlacementCommand}"
                                    Clicked="OnPlacePinClicked"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                                    FontSize="13" Padding="10,0" />
                            <Button Grid.Column="2" Text="✕" Command="{Binding ClearClosuresCommand}"
                                    IsVisible="{Binding ClosuresLabel, Converter={StaticResource IsNotNullOrEmpty}}"
                                    SemanticProperties.Description="Clear closures"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=#888888, Dark=#999999}"
                                    FontSize="14" Padding="0" WidthRequest="44" />
                        </Grid>
                        <Label Text="{Binding ClosuresLabel}"
                               FontSize="12"
                               TextColor="#B71C1C"
                               IsVisible="{Binding ClosuresLabel, Converter={StaticResource IsNotNullOrEmpty}}" />

                        <!-- The routes found, after Plan Route -->
                        <VerticalStackLayout Spacing="6"
                                             IsVisible="{Binding HasRouteOptions}"
                                             BindableLayout.ItemsSource="{Binding RouteOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:RouteOptionViewModel">
                                    <Border Padding="12,4,6,4"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}"
                                            Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="#1565C0" />
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E3F2FD, Dark=#1B3350}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Label}"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                                                   VerticalOptions="Center" />
                                            <Button Grid.Column="1"
                                                    Text="Use"
                                                    Command="{Binding SelectCommand}"
                                                    BackgroundColor="#1565C0" TextColor="White"
                                                    FontSize="13" Padding="14,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Routing's status, a line per step while it works -->
                        <Label Text="{Binding RouteStatusMessage}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding RouteStatusMessage, Converter={StaticResource IsNotNullOrEmpty}}" />
                    </VerticalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <Label Grid.Row="1"
               Text="{Binding StatusMessage}"
               HorizontalOptions="Center"
               FontSize="11"
               TextColor="Gray"
               Padding="8,3" />

    </Grid>

</ContentPage>
